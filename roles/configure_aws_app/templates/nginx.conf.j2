server {
    listen 443 ssl http2;  # Enable SSL and HTTP/2
    server_name {{ default_api }} www.{{ default_api }};

    # Specify the location of the SSL certificate and key
    ssl_certificate /etc/ssl/aws_cloudflare_public.pem;
    ssl_certificate_key /etc/ssl/aws_cloudflare_private.key;

    # Recommended SSL settings
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers EECDH+CHACHA20:EECDH+AES;
    ssl_prefer_server_ciphers on;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 10m;
    ssl_session_tickets off;
    resolver 1.1.1.1 8.8.8.8 valid=300s;
    http2_push_preload on;

    location / {
        proxy_pass http://localhost:3001;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_next_upstream error timeout http_500 http_502 http_503 http_504;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        add_header Cache-Control no-cache;
    }
}

server {
    listen 80;
    server_name {{ default_api }} www.{{ default_api }};
    return 301 https://$host$request_uri;
}